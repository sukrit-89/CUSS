# ─────────────────────────────────────────────────────────────
# ReRail — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key

# ── Stellar ───────────────────────────────────────────────────
VITE_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
VITE_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# ── Soroban registry (optional) ───────────────────────────────
# Leave blank to run without the on-chain registry. Payouts still work; the
# UI just shows campaigns as "not yet on chain".
VITE_RERAIL_REGISTRY_CONTRACT_ID=

# ── Claim Links ───────────────────────────────────────────────
VITE_CLAIM_LINK_BASE_URL=http://localhost:5173

# ── Server-side only (Vercel env vars — NEVER prefix with VITE_) ──
# These are set in Vercel dashboard, not in .env.local
# FEE_PAYER_SECRET=S...your-fee-payer-secret-key
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
#
# Registry admin — separate from the fee payer. Records balance creation and
# claims on-chain on the organizer's behalf. It can only write bookkeeping;
# it can never move funds or change who may claim.
# RERAIL_REGISTRY_CONTRACT_ID=C...
# REGISTRY_ADMIN_SECRET=S...your-registry-admin-secret-key
